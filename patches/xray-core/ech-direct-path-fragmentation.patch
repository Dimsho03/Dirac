diff --git a/transport/internet/tls/ech_fragment.go b/transport/internet/tls/ech_fragment.go
new file mode 100644
index 0000000000000000000000000000000000000000..6ced0fd2d8848dac109d5f16be897d2a6ca74a33
--- /dev/null
+++ b/transport/internet/tls/ech_fragment.go
@@ -0,0 +1,169 @@
+package tls
+
+import (
+	"encoding/binary"
+	"io"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+// echFragmentConn splits the first ECH ClientHello across two TLS records.
+// Some on-path devices match an intact ECH ClientHello even when TCP itself is
+// segmented. TLS handshake messages are allowed to span record boundaries.
+type echFragmentConn struct {
+	net.Conn
+	done bool
+}
+
+func wrapECHClientHelloConn(conn net.Conn, configList []byte) net.Conn {
+	if len(configList) == 0 {
+		return conn
+	}
+	return &echFragmentConn{Conn: conn}
+}
+
+func (c *echFragmentConn) Write(p []byte) (int, error) {
+	if c.done || len(p) < 6 || p[0] != 22 {
+		return c.Conn.Write(p)
+	}
+
+	recordLen := int(binary.BigEndian.Uint16(p[3:5]))
+	if recordLen < 1 || 5+recordLen > len(p) {
+		return c.Conn.Write(p)
+	}
+
+	payload := p[5 : 5+recordLen]
+	split := clientHelloSNISplit(payload)
+	if split <= 0 || split >= len(payload) {
+		return c.Conn.Write(p)
+	}
+	c.done = true
+
+	wire := make([]byte, 0, len(p)+5)
+	wire = appendTLSHandshakeRecord(wire, p[1], p[2], payload[:split])
+	wire = appendTLSHandshakeRecord(wire, p[1], p[2], payload[split:])
+	wire = append(wire, p[5+recordLen:]...)
+
+	if err := writeAll(c.Conn, wire); err != nil {
+		return 0, err
+	}
+	// Report consumption of the caller's original byte slice, not the larger
+	// on-wire representation containing the additional TLS record header.
+	return len(p), nil
+}
+
+func appendTLSHandshakeRecord(dst []byte, major, minor byte, payload []byte) []byte {
+	dst = append(dst, 22, major, minor, byte(len(payload)>>8), byte(len(payload)))
+	return append(dst, payload...)
+}
+
+func writeAll(conn net.Conn, p []byte) error {
+	for len(p) > 0 {
+		n, err := conn.Write(p)
+		if err != nil {
+			return err
+		}
+		if n <= 0 {
+			return io.ErrShortWrite
+		}
+		p = p[n:]
+	}
+	return nil
+}
+
+// clientHelloSNISplit returns an offset inside the first SNI hostname in a TLS
+// ClientHello handshake payload. Splitting inside the hostname guarantees that
+// the visible outer SNI is divided between TLS records without hard-coding a
+// provider-specific public name.
+func clientHelloSNISplit(p []byte) int {
+	// Handshake header: type(1) + length(3).
+	if len(p) < 4 || p[0] != 1 {
+		return -1
+	}
+	off := 4
+	// legacy_version + random.
+	if off+34 > len(p) {
+		return -1
+	}
+	off += 34
+
+	// legacy_session_id.
+	if off+1 > len(p) {
+		return -1
+	}
+	sessionLen := int(p[off])
+	off++
+	if off+sessionLen > len(p) {
+		return -1
+	}
+	off += sessionLen
+
+	// cipher_suites.
+	if off+2 > len(p) {
+		return -1
+	}
+	cipherLen := int(binary.BigEndian.Uint16(p[off : off+2]))
+	off += 2
+	if cipherLen < 2 || off+cipherLen > len(p) {
+		return -1
+	}
+	off += cipherLen
+
+	// legacy_compression_methods.
+	if off+1 > len(p) {
+		return -1
+	}
+	compressionLen := int(p[off])
+	off++
+	if off+compressionLen > len(p) {
+		return -1
+	}
+	off += compressionLen
+
+	// extensions vector.
+	if off+2 > len(p) {
+		return -1
+	}
+	extensionsLen := int(binary.BigEndian.Uint16(p[off : off+2]))
+	off += 2
+	if extensionsLen < 4 || off+extensionsLen > len(p) {
+		return -1
+	}
+	end := off + extensionsLen
+
+	for off+4 <= end {
+		extType := binary.BigEndian.Uint16(p[off : off+2])
+		extLen := int(binary.BigEndian.Uint16(p[off+2 : off+4]))
+		off += 4
+		if off+extLen > end {
+			return -1
+		}
+		if extType == 0 { // server_name
+			ext := p[off : off+extLen]
+			if len(ext) < 5 {
+				return -1
+			}
+			listLen := int(binary.BigEndian.Uint16(ext[0:2]))
+			if listLen+2 > len(ext) {
+				return -1
+			}
+			pos := 2
+			for pos+3 <= 2+listLen {
+				nameType := ext[pos]
+				nameLen := int(binary.BigEndian.Uint16(ext[pos+1 : pos+3]))
+				pos += 3
+				if pos+nameLen > len(ext) {
+					return -1
+				}
+				if nameType == 0 && nameLen > 1 {
+					// Offset relative to the ClientHello payload.
+					return off + pos + nameLen/2
+				}
+				pos += nameLen
+			}
+			return -1
+		}
+		off += extLen
+	}
+	return -1
+}
diff --git a/transport/internet/tls/ech_fragment_test.go b/transport/internet/tls/ech_fragment_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..489917ba7f5db30d0827a3b75b70b4016f37ee8f
--- /dev/null
+++ b/transport/internet/tls/ech_fragment_test.go
@@ -0,0 +1,110 @@
+package tls
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+type captureConn struct {
+	bytes.Buffer
+}
+
+func (c *captureConn) Read([]byte) (int, error)         { return 0, io.EOF }
+func (c *captureConn) Close() error                     { return nil }
+func (c *captureConn) LocalAddr() net.Addr              { return nil }
+func (c *captureConn) RemoteAddr() net.Addr             { return nil }
+func (c *captureConn) SetDeadline(time.Time) error      { return nil }
+func (c *captureConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *captureConn) SetWriteDeadline(time.Time) error { return nil }
+
+func syntheticClientHello(host string) []byte {
+	var body []byte
+	body = append(body, 0x03, 0x03)
+	body = append(body, make([]byte, 32)...)
+	body = append(body, 0) // session id
+	body = append(body, 0, 2, 0x13, 0x01)
+	body = append(body, 1, 0) // compression
+
+	name := []byte(host)
+	sniData := make([]byte, 0, 5+len(name))
+	listLen := 3 + len(name)
+	sniData = append(sniData, byte(listLen>>8), byte(listLen))
+	sniData = append(sniData, 0, byte(len(name)>>8), byte(len(name)))
+	sniData = append(sniData, name...)
+
+	extensions := make([]byte, 0, 4+len(sniData))
+	extensions = append(extensions, 0, 0, byte(len(sniData)>>8), byte(len(sniData)))
+	extensions = append(extensions, sniData...)
+	body = append(body, byte(len(extensions)>>8), byte(len(extensions)))
+	body = append(body, extensions...)
+
+	handshake := []byte{1, byte(len(body) >> 16), byte(len(body) >> 8), byte(len(body))}
+	handshake = append(handshake, body...)
+	return handshake
+}
+
+func tlsRecord(payload []byte) []byte {
+	out := []byte{22, 0x03, 0x01, byte(len(payload) >> 8), byte(len(payload))}
+	return append(out, payload...)
+}
+
+func TestECHFragmentConnSplitsSNIAndPreservesHandshake(t *testing.T) {
+	payload := syntheticClientHello("cloudflare-ech.com")
+	original := tlsRecord(payload)
+	raw := &captureConn{}
+	conn := &echFragmentConn{Conn: raw}
+
+	n, err := conn.Write(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != len(original) {
+		t.Fatalf("Write returned %d, want %d", n, len(original))
+	}
+
+	wire := raw.Bytes()
+	if len(wire) != len(original)+5 {
+		t.Fatalf("wire length = %d, want %d", len(wire), len(original)+5)
+	}
+
+	firstLen := int(binary.BigEndian.Uint16(wire[3:5]))
+	secondStart := 5 + firstLen
+	if secondStart+5 > len(wire) || wire[secondStart] != 22 {
+		t.Fatal("second TLS handshake record not found")
+	}
+	secondLen := int(binary.BigEndian.Uint16(wire[secondStart+3 : secondStart+5]))
+	if secondStart+5+secondLen != len(wire) {
+		t.Fatal("unexpected second record length")
+	}
+
+	reconstructed := append([]byte{}, wire[5:secondStart]...)
+	reconstructed = append(reconstructed, wire[secondStart+5:]...)
+	if !bytes.Equal(reconstructed, payload) {
+		t.Fatal("fragmented records do not reconstruct the original ClientHello")
+	}
+
+	sniPos := bytes.Index(payload, []byte("cloudflare-ech.com"))
+	if sniPos < 0 {
+		t.Fatal("test SNI missing")
+	}
+	if firstLen <= sniPos || firstLen >= sniPos+len("cloudflare-ech.com") {
+		t.Fatalf("TLS record boundary %d does not split the SNI at [%d,%d)", firstLen, sniPos, sniPos+len("cloudflare-ech.com"))
+	}
+}
+
+func TestECHFragmentConnPassesNonClientHello(t *testing.T) {
+	original := tlsRecord([]byte{2, 0, 0, 0})
+	raw := &captureConn{}
+	conn := &echFragmentConn{Conn: raw}
+	n, err := conn.Write(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != len(original) || !bytes.Equal(raw.Bytes(), original) {
+		t.Fatal("non-ClientHello record was modified")
+	}
+}
diff --git a/transport/internet/tls/ech_go127_test.go b/transport/internet/tls/ech_go127_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..be762e9163942560ca19e990bea2d41b1be2493a
--- /dev/null
+++ b/transport/internet/tls/ech_go127_test.go
@@ -0,0 +1,49 @@
+package tls
+
+import (
+	stdtls "crypto/tls"
+	"encoding/base64"
+	"testing"
+)
+
+func TestApplyECHForcesTLS13(t *testing.T) {
+	config := &Config{
+		EchConfigList: base64.StdEncoding.EncodeToString([]byte{0, 1, 2, 3}),
+	}
+	tlsConfig := &stdtls.Config{
+		MinVersion: stdtls.VersionTLS12,
+		MaxVersion: stdtls.VersionTLS12,
+	}
+
+	if err := ApplyECH(config, tlsConfig); err != nil {
+		t.Fatal(err)
+	}
+	if tlsConfig.MinVersion != stdtls.VersionTLS13 {
+		t.Fatalf("MinVersion = %x, want TLS 1.3", tlsConfig.MinVersion)
+	}
+	if tlsConfig.MaxVersion != stdtls.VersionTLS13 {
+		t.Fatalf("MaxVersion = %x, want TLS 1.3", tlsConfig.MaxVersion)
+	}
+	if len(tlsConfig.EncryptedClientHelloConfigList) == 0 {
+		t.Fatal("ECH config list was not populated")
+	}
+}
+
+func TestCopyConfigPreservesTLSVersionsForECH(t *testing.T) {
+	src := &stdtls.Config{
+		MinVersion:                     stdtls.VersionTLS13,
+		MaxVersion:                     stdtls.VersionTLS13,
+		EncryptedClientHelloConfigList: []byte{0, 1, 2, 3},
+	}
+
+	dst := copyConfig(src)
+	if dst.MinVersion != src.MinVersion {
+		t.Fatalf("MinVersion = %x, want %x", dst.MinVersion, src.MinVersion)
+	}
+	if dst.MaxVersion != src.MaxVersion {
+		t.Fatalf("MaxVersion = %x, want %x", dst.MaxVersion, src.MaxVersion)
+	}
+	if len(dst.EncryptedClientHelloConfigList) == 0 {
+		t.Fatal("ECH config list was not copied")
+	}
+}
